<%= turbo_stream.replace "campaign_#{@campaign.id}_progress" do %>
  <%= render "campaigns/progress", campaign: @campaign %>
<% end %>

<%= turbo_stream.prepend "recent_investments" do %>
  <%= render "campaigns/investment", investment: @investment %>
<% end %>

<%= turbo_stream.replace "invest_form" do %>
  <%= render "investments/form", campaign: @campaign, investment: @new_investment %>
<% end %>
