<div id="invest_form">
  <%= form_with model: [campaign, investment], data: { controller: "invest-form" } do |f| %>
    <% if investment.errors.any? %>
      <div class="error-messages">
        <% investment.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <%= f.hidden_field :idempotency_key, value: investment.idempotency_key.presence || SecureRandom.uuid %>

    <div class="field">
      <%= f.label :amount, "Amount (MXN)" %>
      <%= f.number_field :amount,
            value: investment.amount.present? ? investment.amount / 100 : nil,
            min: Investment::MIN_AMOUNT / 100,
            step: 1,
            data: { invest_form_target: "amount" } %>
    </div>

    <div class="actions">
      <%= f.submit "Invest", data: { invest_form_target: "submit" } %>
    </div>
  <% end %>
</div>
